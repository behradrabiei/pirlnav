# =============================================================================
# Eval config for online DINOv2 @ 252 + online ego-object-cloud RL checkpoint
# on the single-scene MP3D 6-cat subset.  Source'd by
# scripts/eval_il_mp3d_1scene_full.sh.
#
# RL fine-tuning starts from the cached-DINOv2 + online-cloud IL checkpoint and
# trains with live DINOv2 + live EgoObjectCloudSensor (sim physics).  Eval uses
# the same online paths as training.
#
# Do NOT set EGO_OBJECT_CLOUD_SENSOR.CACHE_ROOT or override SENSORS to RGB-only
# via EXTRA_OPTS -- that would disable online cloud accumulation.
# =============================================================================

: "${CONFIG:=configs/experiments/rl_objectnav_mp3d_dinov2_252_online_object_cloud.yaml}"

: "${EVAL_CKPT:=data/new_checkpoints_dinov2_rl_252_online_object_cloud/objectnav_rl/mp3d_1scene_6cat_dinov2_rl_252_online_object_cloud/ckpt.10.pth}"

: "${EVAL_SPLITS:=train val}"
: "${TEST_EPISODE_COUNT:=-1}"
: "${NUM_ENVIRONMENTS:=1}"

: "${SUCCESS_DISTANCE:=1.0}"
: "${ALLOW_SLIDING:=True}"

: "${VIDEO_ENABLED:=false}"
: "${VIDEO_FAILED_ONLY:=false}"
: "${VIDEO_FPS:=10}"
: "${VIDEO_RENDER_TOP_DOWN:=true}"

: "${OUT_ROOT:=data/eval_out/dinov2_rl_252_online_object_cloud_ckpt10}"

: "${EXTRA_OPTS:=RL.DDPPO.pretrained False}"

export CONFIG EVAL_CKPT EVAL_SPLITS TEST_EPISODE_COUNT NUM_ENVIRONMENTS \
       VIDEO_ENABLED VIDEO_FAILED_ONLY VIDEO_FPS VIDEO_RENDER_TOP_DOWN OUT_ROOT \
       SUCCESS_DISTANCE ALLOW_SLIDING EXTRA_OPTS
