# =============================================================================
# Eval config for the full-MP3D 21-class IL checkpoint (online DINOv2-base @ 252)
# on the FULL MP3D val split.  Source'd by scripts/eval_il_mp3d_1scene_full.sh.
#
# Unlike the other variants, this checkpoint was trained on the complete MP3D
# ObjectNav dataset (all 21 goal categories, 11 val scenes) rather than the
# single-scene 6-category subset.  The policy's objectgoal embedding is sized
# 21 from the dataset's category_to_task_category_id, so we MUST evaluate
# against the full dataset (a 6-cat dataset would build a 6-row embedding and
# fail to load the checkpoint).
#
# Architecture matches configs/experiments/il_objectnav_mp3d_dinov2.yaml
# (online DINOv2-base, RGB + objectgoal + compass + gps + prev-action,
# hidden 2048, 2-layer GRU).  The frozen DINOv2 weights are pulled from
# HuggingFace at construction; only the policy head/RNN live in the ckpt.
# =============================================================================

# Local experiment config (online DINOv2; we do NOT use the ckpt's embedded
# config, which points at cluster-only paths -- the launcher sets
# EVAL.USE_CKPT_CONFIG False).
: "${CONFIG:=configs/experiments/il_objectnav_mp3d_dinov2.yaml}"

# Checkpoint to evaluate.
: "${EVAL_CKPT:=incoming/full_mp3d_il_300M_500M/ckpt.87.pth}"

# Full MP3D val split only.
: "${EVAL_SPLITS:=val}"

# -1 = all episodes (2195 across 11 scenes).
: "${TEST_EPISODE_COUNT:=-1}"

# Concurrent habitat-sim envs.  MUST stay <= number of scenes in the split
# (11 for val) so construct_envs splits scenes DISJOINTLY across envs; above
# that, every env loads every scene and the eval loop's pause-on-duplicate
# logic silently drops/duplicates episodes.  Coverage is exact for any value
# <= 11, so this only trades wall-clock, never episodes.  Start at 8 on a
# 32 GB GPU and bump toward 11 if nvidia-smi shows headroom.
: "${NUM_ENVIRONMENTS:=8}"

# --- Task-config overrides -------------------------------------------------
# Match how every prior model was evaluated: 1.0 m success distance, sliding
# enabled (the demonstrations were recorded with these settings).
: "${SUCCESS_DISTANCE:=1.0}"
: "${ALLOW_SLIDING:=True}"

# --- Video recording -------------------------------------------------------
# Off by default (online DINOv2 over 2195 episodes is slow).  For a failed-only
# pass later:  VIDEO_ENABLED=true VIDEO_FAILED_ONLY=true bash scripts/eval_il_mp3d_1scene_full.sh configs/eval_full_mp3d_dinov2_300M.env
: "${VIDEO_ENABLED:=false}"
: "${VIDEO_FAILED_ONLY:=false}"
: "${VIDEO_FPS:=10}"
: "${VIDEO_RENDER_TOP_DOWN:=true}"

# --- Output layout ---------------------------------------------------------
: "${OUT_ROOT:=data/eval_out/full_mp3d_il_300M_ckpt87}"

# --- Extra trailing config opts (applied last, so they win) ----------------
# 1. Point the dataset at the full MP3D val split (overrides the 6-cat subset
#    path baked into the task YAML).
# 2. Pin a deterministic, full-coverage episode iterator: no shuffle and no
#    forced mid-scene switch (CYCLE stays True so the trainer's pause-on-repeat
#    stop condition still works).
# 3. Disable test-time visual augmentation.  The default
#    POLICY.RGB_ENCODER.use_augmentations_test_time=True would apply ColorJitter
#    + random pixel shift to every eval frame; for a clean benchmark we feed the
#    raw resized observation instead.
# NB: set via a plain quoted assignment, NOT `${EXTRA_OPTS:=...}`.  The
# `{split}` placeholders contain a `}` that would prematurely close a
# `${...:=...}` parameter expansion; in a plain double-quoted string braces are
# literal.  The `[[ -z ]]` guard preserves "env var wins" override behaviour.
if [[ -z "${EXTRA_OPTS:-}" ]]; then
  EXTRA_OPTS="TASK_CONFIG.DATASET.DATA_PATH /data/hm3d_datasets/MP3D/objectnav_mp3d_v1/{split}/{split}.json.gz TASK_CONFIG.ENVIRONMENT.ITERATOR_OPTIONS.SHUFFLE False TASK_CONFIG.ENVIRONMENT.ITERATOR_OPTIONS.MAX_SCENE_REPEAT_STEPS -1 POLICY.RGB_ENCODER.use_augmentations_test_time False"
fi

export CONFIG EVAL_CKPT EVAL_SPLITS TEST_EPISODE_COUNT NUM_ENVIRONMENTS \
       VIDEO_ENABLED VIDEO_FAILED_ONLY VIDEO_FPS VIDEO_RENDER_TOP_DOWN OUT_ROOT \
       SUCCESS_DISTANCE ALLOW_SLIDING EXTRA_OPTS
