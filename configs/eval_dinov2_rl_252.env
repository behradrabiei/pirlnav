# =============================================================================
# Easy-to-edit config for evaluating the DINOv2-only @ 252 RL-finetuned
# checkpoint on the single-scene MP3D 6-cat subset.  Source'd by
# scripts/eval_il_mp3d_1scene_full.sh.
#
# RL fine-tuning starts from the cached-DINOv2 IL checkpoint and runs online
# DINOv2 @ 252x252 during training (policy actions through sim physics).
# Eval uses the same online DINOv2 forward path as IL eval.
# =============================================================================

: "${CONFIG:=configs/experiments/rl_objectnav_mp3d_dinov2_252.yaml}"

# Final checkpoint from a full RL run (update 20000 = ckpt.10 with 10 ckpts
# spaced across the run).  Override with EVAL_CKPT=... on the command line.
: "${EVAL_CKPT:=data/new_checkpoints_dinov2_rl_252/objectnav_rl/mp3d_1scene_6cat_dinov2_rl_252/ckpt.10.pth}"

: "${EVAL_SPLITS:=train val}"
: "${TEST_EPISODE_COUNT:=-1}"
: "${NUM_ENVIRONMENTS:=1}"

: "${SUCCESS_DISTANCE:=1.0}"
: "${ALLOW_SLIDING:=True}"

: "${VIDEO_ENABLED:=false}"
: "${VIDEO_FAILED_ONLY:=false}"
: "${VIDEO_FPS:=10}"
: "${VIDEO_RENDER_TOP_DOWN:=true}"

: "${OUT_ROOT:=data/eval_out/dinov2_rl_252_ckpt10}"

# The RL yaml sets RL.DDPPO.pretrained True so training initializes from the IL
# checkpoint.  At eval time we load the RL checkpoint directly, so disable the
# pretrained-init path (avoids requiring the IL .pth to exist and a wasted
# double-load before the eval checkpoint overwrites it).  Mirrors the upstream
# scripts/1-objectnav-rl-ft-eval.sh pattern.
: "${EXTRA_OPTS:=RL.DDPPO.pretrained False}"

export CONFIG EVAL_CKPT EVAL_SPLITS TEST_EPISODE_COUNT NUM_ENVIRONMENTS \
       VIDEO_ENABLED VIDEO_FAILED_ONLY VIDEO_FPS VIDEO_RENDER_TOP_DOWN OUT_ROOT \
       SUCCESS_DISTANCE ALLOW_SLIDING EXTRA_OPTS
